# Copy this file to .env and fill it in. Never share or commit .env.

# ── Platform server ──────────────────────────────────────────────
# Long random string; sessions are signed with it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true when the site is served over HTTPS (always, in production)
COOKIE_SECURE=false
# The public address clients use (pre-filled in the connector download)
PUBLIC_URL=http://127.0.0.1:8000
# SQLite by default. PostgreSQL: postgresql+psycopg://user:password@localhost/fxsignals
DATABASE_URL=

# Price data for the signal engine: demo | mt5 | twelvedata
#   demo        synthetic prices, development only
#   mt5         MetaTrader 5 terminal on the same Windows server
#   twelvedata  REST API, works on a Linux VPS (free key at twelvedata.com)
PRICE_FEED=demo
TWELVEDATA_API_KEY=
# mt5 feed only: ending your broker adds to symbol names (EURUSD.m -> .m)
MT5_SYMBOL_SUFFIX=
# mt5 feed only: broker server clock vs UTC in hours. Leave empty: it is learned from live prices
MT5_UTC_OFFSET_HOURS=
# mt5 feed only: how that clock follows summer time, so older bars convert to UTC right. auto (default) detects
# New York close (New York + 7h, most FX brokers); else nyclose, fixed (one offset all year) or a zone like Europe/Athens
MT5_SERVER_TZ=auto

# Claude API key for AI news analysis and the AI coach (console.anthropic.com)
ANTHROPIC_API_KEY=
# Model used for analysis and coaching
AI_MODEL=claude-opus-5-5

# Telegram: one platform bot for everyone (create it with @BotFather)
TELEGRAM_BOT_TOKEN=

# ── Economic calendar ───────────────────────────────────────────
# forexfactory (default): the free ForexFactory weekly feed; it has no actual (released) values
# investing: the Investing.com calendar, released values included, through the Apify actor
#   kibaale/investing-economic-calendar-scraper. Needs APIFY_TOKEN (console.apify.com/settings/integrations).
#   Apify bills every row (from $5.50 / 1,000), so the engine asks for High + Medium releases only: the next 7 days
#   every INVESTING_FULL_HOURS, today's High releases every INVESTING_TODAY_MINUTES and again just after one prints
#   (roughly $1.5-4 per trading day with the defaults, an estimate). If Investing.com stops answering, ForexFactory
#   takes over by itself. Investing.com's terms forbid using its data without its written permission: switching
#   this on is your decision.
CALENDAR_SOURCE=forexfactory
APIFY_TOKEN=
# Investing.com only: ISO country codes (EU = euro area) and how often to ask
INVESTING_COUNTRIES=US,EU,DE,GB,JP,CH,CA,AU,NZ
INVESTING_FULL_HOURS=12
INVESTING_TODAY_MINUTES=60

# ── v1 personal bot (main.py live / connector on your own PC) ────
# MetaTrader 5 login (optional if the MT5 terminal is already open and logged in)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Full path to terminal64.exe (optional, only if you have several MT5 installs)
MT5_PATH=
# v1 bot notifications
TELEGRAM_CHAT_ID=
